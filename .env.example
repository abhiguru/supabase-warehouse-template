############################################################
# Supabase Warehouse Template - Environment Configuration
############################################################
# Operator setup writes a private copy under the explicitly selected state directory.
############################################################

# ============================================================
# DATABASE
# ============================================================
POSTGRES_PASSWORD=changeme                    # PostgreSQL superuser password
POSTGRES_HOST=db                              # Docker service name (don't change)
POSTGRES_DB=postgres                          # Database name
POSTGRES_PORT=5432                            # Internal port (don't change)

# ============================================================
# JWT & AUTHENTICATION
# ============================================================
# setup.sh generates new credentials once; existing configurations are preserved.
# Generated at installation; never use this template directly.
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long
JWT_EXPIRY=3600                               # Token expiry in seconds (1 hour)

# Public and service keys are generated by setup.
ANON_KEY=generated-by-setup
SERVICE_ROLE_KEY=generated-by-setup

# Internal secrets (auto-generated by setup.sh)
SECRET_KEY_BASE=changeme-run-setup-sh         # Realtime & Supavisor secret (64+ chars)
VAULT_ENC_KEY=changeme-run-setup-sh           # Vault encryption key (32 hex chars)

# ============================================================
# API GATEWAY (Kong)
# ============================================================
KONG_HTTP_PORT=18000
CORS_ALLOWED_ORIGIN=https://api.example.com      # One exact trusted browser origin; never use * with credentials

# ============================================================
# STUDIO DASHBOARD
# ============================================================
DASHBOARD_USERNAME=supabase                   # Studio login username
DASHBOARD_PASSWORD=changeme                   # Studio login password
STUDIO_DEFAULT_ORGANIZATION=My Warehouse      # Organization name in Studio
STUDIO_DEFAULT_PROJECT=Warehouse System        # Project name in Studio
SUPABASE_PUBLIC_URL=https://api.example.com      # Canonical public API origin

# ============================================================
# POSTGREST
# ============================================================
PGRST_DB_SCHEMAS=public,storage,graphql_public

# ============================================================
# URLS & REDIRECTS
# ============================================================
SITE_URL=https://api.example.com                # Trusted browser origin if any
ADDITIONAL_REDIRECT_URLS=https://api.example.com
API_EXTERNAL_URL=https://api.example.com        # External API origin

# ============================================================
# EDGE FUNCTIONS
# ============================================================
# Edge JWT verification is mandatory; only hello/get-public-config are public.

# ============================================================
# EMAIL (GoTrue - disabled by default)
# ============================================================
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=supabase-mail
SMTP_PORT=2500
SMTP_USER=fake_mail_user
SMTP_PASS=fake_mail_password
SMTP_SENDER_NAME=Warehouse System
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

# ============================================================
# PHONE AUTH
# ============================================================
ENABLE_PHONE_SIGNUP=true
ENABLE_PHONE_AUTOCONFIRM=true
DISABLE_SIGNUP=false
ENABLE_ANONYMOUS_USERS=false

# ============================================================
# STORAGE & IMAGE PROCESSING
# ============================================================
IMGPROXY_ENABLE_WEBP_DETECTION=true

# ============================================================
# ANALYTICS / LOGGING (Logflare)
# ============================================================
# These are generated for the private configuration.
# Analytics is disabled by default in docker-compose.override.yml.
LOGFLARE_LOGGER_BACKEND_API_KEY=changeme-logflare-api-key
LOGFLARE_PUBLIC_ACCESS_TOKEN=changeme-logflare-public-token
LOGFLARE_PRIVATE_ACCESS_TOKEN=changeme-logflare-private-token
LOGFLARE_API_KEY=changeme-logflare-api-key

# ============================================================
# DOCKER
# ============================================================
DOCKER_SOCKET_LOCATION=/var/run/docker.sock

# ============================================================
# CONNECTION POOLER (Supavisor) — profile: pooler
# ============================================================
POOLER_PROXY_PORT_TRANSACTION=6543
POOLER_DEFAULT_POOL_SIZE=50                   # Connections per tenant
POOLER_MAX_CLIENT_CONN=150                    # Max client connections
POOLER_TENANT_ID=warehouse-tenant             # Tenant identifier
POOLER_DB_POOL_SIZE=25                        # DB-side pool size
POOLER_REPORTING_POOL_SIZE=25                 # Reporting query pool

# ============================================================
# SMS PROVIDER (for custom OTP auth)
# ============================================================
# Operator mode uses real MSG91 Flow SMS. MSG91_TEMPLATE_ID must be an approved
# Flow template with VAR1 as the six-digit OTP.
AUTH_MODE=operator
SMS_PROVIDER=msg91
SMS_PRODUCTION_MODE=true

# MSG91 Configuration (DLT compliant for India)
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_TEMPLATE_ID=your-msg91-template-id
MSG91_PE_ID=your-msg91-pe-id
MSG91_SENDER_ID=WHOUSE

# ============================================================
# CUPS PRINTING — profile: printing
# ============================================================
CUPS_ADMIN_USER=admin
CUPS_ADMIN_PASSWORD=changeme

# ============================================================
# MONITORING — profile: monitoring
# ============================================================
ENABLE_PROM_METRICS=true
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASS=changeme

# External alert delivery is intentionally unconfigured. The monitoring profile
# validates alerts locally; copy the documented example only after selecting a provider.

# ============================================================
# STUDIO AI FEATURES (optional)
# ============================================================
OPENAI_API_KEY=                          # Optional: enables AI-powered features in Supabase Studio

# ============================================================
# GOOGLE OAUTH (disabled by default)
# ============================================================
GOTRUE_EXTERNAL_GOOGLE_ENABLED=false
GOTRUE_EXTERNAL_GOOGLE_CLIENT_ID=
GOTRUE_EXTERNAL_GOOGLE_SECRET=
GOTRUE_EXTERNAL_GOOGLE_REDIRECT_URI=

# The gateway binds to loopback for a host TLS reverse proxy. Data paths must be
# chosen explicitly outside the checkout and are never regenerated on rerun.
BIND_ADDRESS=127.0.0.1
APP_ENV=production
WAREHOUSE_DB_PATH=
WAREHOUSE_STORAGE_PATH=
WAREHOUSE_MANIFEST_PATH=
WAREHOUSE_PROJECT_NAME=
