############################################################
# Supabase Warehouse Template - Environment Configuration
############################################################
# Operator setup writes a private copy under the explicitly selected state directory.
#
# Not set in this file: WAREHOUSE_STATE_DIR is a variable of the operator's shell
# (export WAREHOUSE_STATE_DIR=/absolute/path/to/this/warehouse). Every operator
# command reads it to find <state>/config/compose.env, the private copy of this file.
############################################################

# ============================================================
# DATABASE
# ============================================================
POSTGRES_PASSWORD=changeme                    # Superuser password (supabase_admin)
# Every service login has its own password (docs/CONTAINER_SECURITY.md,
# "Database passwords"). Setup generates each once; a state written before they
# existed gains them on the next setup run. Never reuse one value for two lines.
DB_PASSWORD_AUTHENTICATOR=generated-by-setup  # PostgREST (role authenticator)
DB_PASSWORD_STORAGE=generated-by-setup        # Storage (supabase_storage_admin)
# The pooler's login (DB_PASSWORD_POOLER) and its secrets (SECRET_KEY_BASE, VAULT_ENC_KEY) exist only while the
# pooler is on: `bash scripts/pooler.sh on` generates them.
POSTGRES_HOST=db                              # Docker service name (don't change)
POSTGRES_DB=postgres                          # Database name
POSTGRES_PORT=5432                            # Internal port (don't change)

# ============================================================
# JWT & AUTHENTICATION
# ============================================================
# setup.sh generates new credentials once; existing configurations are preserved.
# Generated at installation; never use this template directly.
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long
JWT_EXPIRY=3600                               # Token expiry in seconds (1 hour)

# Public and service keys are generated by setup.
ANON_KEY=generated-by-setup
SERVICE_ROLE_KEY=generated-by-setup

# ============================================================
# API GATEWAY (nginx)
# ============================================================
# The loopback port the Cloudflare Tunnel connector calls. (Named KONG_HTTP_PORT while the gateway was Kong; a file
# that still has that name keeps working until setup --gateway-port changes it.)
GATEWAY_HTTP_PORT=18000
CORS_ALLOWED_ORIGIN=https://api.example.com      # One exact trusted browser origin; never use * with credentials

# ============================================================
# LAN FALLBACK (gateway-lan) — profile: lan. Off by default.
# ============================================================
# A second, plain-http listener on the host's own private address, used by the app only when the internet path to the public
# address fails (docs/OPERATOR_INSTALL.md, "LAN fallback"). Written by `bash scripts/lan.sh on auto` (and removed by `off`); do
# not edit by hand. While it is off the container does not exist and nothing is published (loopback is the default bind).
# `on` also adds COMPOSE_PROFILES=lan to this file, which is how start.sh and the boot unit start the gateway-lan service.
LAN_ENABLED=false                             # true while the fallback is on; get-config then offers the address to signed-in phones
LAN_BIND_IP=127.0.0.1                         # The host's own private (RFC 1918) address the container publishes on
LAN_HTTP_PORT=8080                            # The port on that address (1024-65535)
# The warehouse network that may connect, e.g. 192.168.1.0/24 (derived from the interface). No comment on the line below: an empty
# value followed by a comment is read as the comment by some of the tools.
LAN_CIDR=

# ============================================================
# PUBLIC URL
# ============================================================
SUPABASE_PUBLIC_URL=https://api.example.com      # Canonical public API origin

# ============================================================
# POSTGREST
# ============================================================
PGRST_DB_SCHEMAS=public

# ============================================================
# URLS & REDIRECTS
# ============================================================
SITE_URL=https://api.example.com                # Trusted browser origin if any
API_EXTERNAL_URL=https://api.example.com        # External API origin

# ============================================================
# EDGE FUNCTIONS
# ============================================================
# Edge JWT verification is mandatory; only hello/get-public-config are public.

# ============================================================
# CONNECTION POOLER (Supavisor) — profile: pooler. Off by default.
# `bash scripts/pooler.sh on` turns it on (role, database, secrets, start); `off` stops it.
# ============================================================
POOLER_ENABLED=false                          # Written by scripts/pooler.sh; do not edit by hand
POOLER_DEFAULT_POOL_SIZE=50                   # Connections per tenant
POOLER_MAX_CLIENT_CONN=150                    # Max client connections
POOLER_TENANT_ID=warehouse-tenant             # Tenant identifier
POOLER_DB_POOL_SIZE=25                        # DB-side pool size

# ============================================================
# SMS PROVIDER (for custom OTP auth)
# ============================================================
# Operator mode uses real MSG91 Flow SMS. MSG91_TEMPLATE_ID must be an approved
# Flow template with VAR1 as the six-digit OTP.
AUTH_MODE=operator
SMS_PROVIDER=msg91
SMS_PRODUCTION_MODE=true

# Central sign-in (docs/CENTRAL_LOGIN.md): the association's token issuer, and its public keys as an
# https address or as a file copied into the state. All empty = off; set them with setup.sh.
CENTRAL_ISSUER=
CENTRAL_JWKS_URL=
CENTRAL_JWKS_FILE=
# on = this facility also asks for its own SMS code at every central sign-in (setup.sh --central-local-code); empty or off = the association's sign-in alone.
CENTRAL_LOCAL_CODE=

# Optional letterhead image on the GRN, dispatch, invoice and customer stock PDFs: letterhead.jpg or
# letterhead.png in the state's public directory. Empty = plain PDFs. Set it with setup.sh --letterhead-file.
LETTERHEAD_FILE=

# MSG91 Configuration (DLT compliant for India)
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_TEMPLATE_ID=your-msg91-template-id
MSG91_PE_ID=your-msg91-pe-id
MSG91_SENDER_ID=WHOUSE

# ============================================================
# CUPS PRINTING — profile: printing
# ============================================================
CUPS_ADMIN_USER=admin
CUPS_ADMIN_PASSWORD=changeme

# ============================================================
# TAPO SENSORS — profile: sensors (docs/SENSORS.md)
# ============================================================
# Empty = the bridge is not configured; it is started only with --profile sensors.
# Hub LAN addresses, comma-separated (for example 192.168.1.74,192.168.1.79).
SENSOR_BRIDGE_HUBS=
# The Tapo cloud account the hubs were set up with (the hubs check it locally).
TAPO_USERNAME=
TAPO_PASSWORD=
# 64 hex characters minted with scripts/sensor-ingest-key.sql; shown once.
SENSOR_INGEST_KEY=
# A short name for this bridge in sensor_hubs.bridge_id (optional; empty = sensor-bridge).
SENSOR_BRIDGE_ID=
# Optional, with their defaults: SENSOR_BRIDGE_POLL_SECONDS=300, SENSOR_BRIDGE_POST_SECONDS=60,
# SENSOR_BRIDGE_HEARTBEAT_SECONDS=300, SENSOR_BRIDGE_MAX_BATCH=200, SENSOR_BRIDGE_LOG_LEVEL=INFO
# (poll and heartbeat both 300: every sensor is sampled every 5 minutes);
# SENSOR_BRIDGE_REBOOT_CRON (five-field cron in UTC, empty = never) reboots the hubs, e.g. weekly.

# ============================================================
# MONITORING — the checker (scripts/watch.mjs, run by a systemd timer)
# ============================================================
# Alerts go to the facility's own Slack channel. The webhook URL is not set here: setup.sh --operator asks for it
# (or takes --alert-webhook-file) and keeps it in the state as config/slack-webhook-url, mode 0600
# (docs/MONITORING.md, "Alert delivery").

# The gateway is published on 127.0.0.1 only (docker/docker-compose.yml), for the Cloudflare Tunnel. Data paths must be
# chosen explicitly outside the checkout and are never regenerated on rerun.
APP_ENV=production
WAREHOUSE_DB_PATH=
WAREHOUSE_STORAGE_PATH=
WAREHOUSE_MANIFEST_PATH=
WAREHOUSE_PROJECT_NAME=
