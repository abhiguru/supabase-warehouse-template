############################################################
# Supabase Warehouse Template - Environment Configuration
############################################################
# Copy this file to docker/.env and customize values.
# Run ./setup.sh to auto-generate secrets.
############################################################

# ============================================================
# DATABASE
# ============================================================
POSTGRES_PASSWORD=changeme                    # PostgreSQL superuser password
POSTGRES_HOST=db                              # Docker service name (don't change)
POSTGRES_DB=postgres                          # Database name
POSTGRES_PORT=5432                            # Internal port (don't change)

# ============================================================
# JWT & AUTHENTICATION
# ============================================================
# IMPORTANT: Run ./setup.sh or ./rotate-keys.sh to generate production keys.
# The demo keys below are for initial setup ONLY.
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long
JWT_EXPIRY=3600                               # Token expiry in seconds (1 hour)

# Demo keys (will be replaced by setup.sh)
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.HSyNGtrUgwIUdhOBBCZxKuHC_bLXB6xg8DtCbNpg4Hg
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.-RKJWdbBTY9uZxrZkRCm0053TIzHIWg8zyFheMQ_QeY

# Internal secrets (auto-generated by setup.sh)
SECRET_KEY_BASE=changeme-run-setup-sh         # Realtime & Supavisor secret (64+ chars)
VAULT_ENC_KEY=changeme-run-setup-sh           # Vault encryption key (32 hex chars)

# ============================================================
# API GATEWAY (Kong)
# ============================================================
KONG_HTTP_PORT=8000                           # HTTP API port
KONG_HTTPS_PORT=8443                          # HTTPS API port

# ============================================================
# STUDIO DASHBOARD
# ============================================================
DASHBOARD_USERNAME=supabase                   # Studio login username
DASHBOARD_PASSWORD=changeme                   # Studio login password
STUDIO_DEFAULT_ORGANIZATION=My Warehouse      # Organization name in Studio
STUDIO_DEFAULT_PROJECT=Warehouse System        # Project name in Studio
STUDIO_PORT=127.0.0.1:54323                   # Studio port (localhost only for security)
SUPABASE_PUBLIC_URL=http://localhost:8000      # Public-facing API URL

# ============================================================
# POSTGREST
# ============================================================
PGRST_DB_SCHEMAS=public,storage,graphql_public

# ============================================================
# URLS & REDIRECTS
# ============================================================
SITE_URL=http://localhost:5173                # Frontend app URL
ADDITIONAL_REDIRECT_URLS=http://localhost:5173/dashboard
API_EXTERNAL_URL=http://localhost:8000        # External API URL

# ============================================================
# EDGE FUNCTIONS
# ============================================================
FUNCTIONS_VERIFY_JWT=false                    # Set true in production

# ============================================================
# EMAIL (GoTrue - disabled by default)
# ============================================================
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=supabase-mail
SMTP_PORT=2500
SMTP_USER=fake_mail_user
SMTP_PASS=fake_mail_password
SMTP_SENDER_NAME=Warehouse System
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

# ============================================================
# PHONE AUTH
# ============================================================
ENABLE_PHONE_SIGNUP=true
ENABLE_PHONE_AUTOCONFIRM=true
DISABLE_SIGNUP=false
ENABLE_ANONYMOUS_USERS=false

# ============================================================
# STORAGE & IMAGE PROCESSING
# ============================================================
IMGPROXY_ENABLE_WEBP_DETECTION=true

# ============================================================
# ANALYTICS / LOGGING (Logflare)
# ============================================================
# These are auto-generated placeholder tokens for local dev.
# Analytics is disabled by default in docker-compose.override.yml.
LOGFLARE_LOGGER_BACKEND_API_KEY=changeme-logflare-api-key
LOGFLARE_PUBLIC_ACCESS_TOKEN=changeme-logflare-public-token
LOGFLARE_PRIVATE_ACCESS_TOKEN=changeme-logflare-private-token
LOGFLARE_API_KEY=changeme-logflare-api-key

# ============================================================
# DOCKER
# ============================================================
DOCKER_SOCKET_LOCATION=/var/run/docker.sock

# ============================================================
# CONNECTION POOLER (Supavisor) — profile: pooler
# ============================================================
POOLER_PROXY_PORT_TRANSACTION=6543
POOLER_DEFAULT_POOL_SIZE=50                   # Connections per tenant
POOLER_MAX_CLIENT_CONN=150                    # Max client connections
POOLER_TENANT_ID=warehouse-tenant             # Tenant identifier
POOLER_DB_POOL_SIZE=25                        # DB-side pool size
POOLER_REPORTING_POOL_SIZE=25                 # Reporting query pool

# ============================================================
# SMS PROVIDER (for custom OTP auth)
# ============================================================
# Supported providers: 'twilio' or 'msg91'
SMS_PROVIDER=twilio
SMS_PRODUCTION_MODE=false                     # false = test mode (OTP: 123456)

# Twilio Configuration
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# MSG91 Configuration (DLT compliant for India)
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_TEMPLATE_ID=your-msg91-template-id
MSG91_PE_ID=your-msg91-pe-id
MSG91_SENDER_ID=WHOUSE

# ============================================================
# CUPS PRINTING — profile: printing
# ============================================================
CUPS_ADMIN_USER=admin
CUPS_ADMIN_PASSWORD=changeme

# ============================================================
# MONITORING — profile: monitoring
# ============================================================
ENABLE_PROM_METRICS=true
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASS=changeme

# ============================================================
# SLACK WEBHOOKS (AlertManager)
# ============================================================
# Create incoming webhooks at https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_CRITICAL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_WEBHOOK_DATABASE=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_WEBHOOK_INFRASTRUCTURE=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_WEBHOOK_PRINTER=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_WEBHOOK_SECURITY=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_WEBHOOK_BACKUP=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ============================================================
# STUDIO AI FEATURES (optional)
# ============================================================
OPENAI_API_KEY=                          # Optional: enables AI-powered features in Supabase Studio

# ============================================================
# GOOGLE OAUTH (disabled by default)
# ============================================================
GOTRUE_EXTERNAL_GOOGLE_ENABLED=false
GOTRUE_EXTERNAL_GOOGLE_CLIENT_ID=
GOTRUE_EXTERNAL_GOOGLE_SECRET=
GOTRUE_EXTERNAL_GOOGLE_REDIRECT_URI=
