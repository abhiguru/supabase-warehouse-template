# PLACEHOLDER: no key is listed yet. While this file has no key line, upgrade.sh prints a warning and does not check tag signatures, so
# that the first signed release can be reached. The maintainer adds the real public key as one line, in a commit of its own made BEFORE the
# first signed tag:
#
#   release namespaces="git" ssh-ed25519 AAAA... warehouse-release-signing
