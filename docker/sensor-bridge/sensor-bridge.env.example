# Settings of the sensor bridge (README.md, "Settings"). Copy to sensor-bridge.env,
# chmod 600, and fill in. Placeholders only: never commit the filled-in file.

# Hub addresses, comma-separated (give each hub a fixed address on the router).
SENSOR_BRIDGE_HUBS=192.0.2.10,192.0.2.11

# The Tapo account the hubs belong to.
TAPO_USERNAME=
TAPO_PASSWORD=

# The backend's ingest function and the key minted for this bridge
# (scripts/sensor-ingest-key.sql; 64 lowercase hex characters).
SENSOR_INGEST_URL=https://backend.example.test/functions/v1/ingest-sensor-readings
SENSOR_INGEST_KEY=

# Optional (defaults shown).
SENSOR_BRIDGE_ID=sensor-bridge
# Poll and heartbeat both 300: every sensor is sampled every 5 minutes.
#SENSOR_BRIDGE_POLL_SECONDS=300
#SENSOR_BRIDGE_POST_SECONDS=60
#SENSOR_BRIDGE_HEARTBEAT_SECONDS=300
#SENSOR_BRIDGE_MAX_BATCH=200
# Weekly hub reboot, cron fields in UTC (this one is Sunday 03:00 in India). Off when empty.
#SENSOR_BRIDGE_REBOOT_CRON=30 21 * * 6
#SENSOR_BRIDGE_LOG_LEVEL=INFO
