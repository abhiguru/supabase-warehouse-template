{
  "name": "supabase-warehouse-template-checks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:migrations": "bash tests/migrations.sh",
    "test:recovery": "bash tests/recovery-check.sh",
    "db:backup": "bash scripts/backup.sh",
    "db:verify-restore": "bash scripts/verify-restore.sh",
    "db:restore": "bash scripts/restore.sh",
    "db:restore-host": "bash scripts/restore-host.sh",
    "db:rotate-passwords": "bash scripts/rotate-db-passwords.sh",
    "test:db-roles": "bash scripts/db-roles.sh check",
    "test:rotation": "node tests/operator-api-rotation.mjs",
    "test:gateway": "node tests/gateway-smoke.mjs",
    "test:anon-timeout": "node tests/anon-timeout-check.mjs",
    "test:gateway-dns": "bash tests/gateway-dns-check.sh",
    "test:load": "node tests/load-smoke.mjs",
    "test:cups": "bash tests/cups-check.sh",
    "test:sensors": "bash tests/sensor-bridge-check.sh",
    "scan:images": "bash scripts/scan-images.sh",
    "retention:preview": "bash scripts/retention.sh preview",
    "retention:apply": "bash scripts/retention.sh apply",
    "storage:retag": "bash scripts/storage-retag.sh",
    "check:contract": "node scripts/check-mobile-contract.mjs",
    "doctor": "node scripts/doctor.mjs",
    "test:pooler": "bash tests/pooler-check.sh",
    "check:container-dependencies": "npm audit --prefix docker/storage --omit=dev --audit-level=high && npm audit --prefix docker/pdf-renderer --omit=dev --audit-level=high",
    "baseline:verify": "bash scripts/baseline/verify-baseline.sh"
  },
  "devDependencies": {
    "jose": "6.2.12"
  }
}
